# Sign in with Google (Auth.js). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add this redirect URI: http://localhost:3000/api/auth/callback/google (plus your production URL).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required in production: generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Production behind a proxy/host that does not forward the Host header: set AUTH_URL=https://your.domain

# Required in production: 32+ random characters used to seal the session cookie.
# In development a throwaway secret is generated when this is unset.
SESSION_SECRET=

# Optional: when set, connecting also requires this code (useful on a public deployment).
ACCESS_CODE=

# MongoDB connection string for saved data. Keep the real value in .env.local only.
MONGODB_URI=
# Optional database name. Defaults to "postie".
MONGODB_DB=

# Lead finder (beta). Each signed-in account gets LEADS_FREE_RUNS searches (default 2); after that
# they see a "still in beta" message. Counting needs MONGODB_URI. Without it, limited accounts are refused.
SERPER_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LEADS_FREE_RUNS=2
# Comma-separated Google account emails with no limit, e.g. you@gmail.com,teammate@gmail.com
LEADS_UNLIMITED_EMAILS=

# Limits
MAX_RECIPIENTS_PER_RUN=100
SEND_DELAY_MS=1500

# Dev-only "local default account" shortcut. Ignored when NODE_ENV=production.
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
